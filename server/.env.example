# Kopieren nach ".env" und anpassen.

# Ordner mit deinen Filmen (Schema wie im Launcher: <Film>/Film.mp4 + Name/Info/FSK/Icon/Banner...).
# Windows-Pfade mit / schreiben.
FILME_ORDNER=D:/Filme

# Ordner mit deiner Musik (Schema: <Interpret>/<Interpret> - <Album>/01 - <Interpret> - <Titel>.mp3).
MUSIK_ORDNER=D:/Musik

# Name, den der Launcher anzeigt.
SERVER_NAME=Media-Server

# Optional: gemeinsamer Schlüssel, damit nicht jedes Gerät im WLAN zugreifen kann.
API_KEY=
